# PolicyFlow local environment template.
# Copy to .env (never committed) and replace the placeholder values below.

# PostgreSQL — credentials and database the core service connects to.
POSTGRES_USER=policyflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=policyflow

# RabbitMQ — broker credentials (management UI uses the same login).
RABBITMQ_DEFAULT_USER=policyflow
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq

# Frontend — optional host port nginx is published on locally (defaults to 80).
# Set this when running several projects at once so the ports don't clash, e.g.
# FRONTEND_HOST_PORT=9001 then browse http://localhost:9001
# FRONTEND_HOST_PORT=80

# Let's Encrypt / certbot — used ONLY by the prod TLS overlay and the one-time
# ops/init-letsencrypt.sh issuance bootstrap. Not needed for local dev.
CERTBOT_EMAIL=you@example.com
CERTBOT_DOMAIN=policyflow.joeyshub.com
# Set to 1 to issue against the Let's Encrypt staging environment (untrusted cert,
# no rate limits) while testing the bootstrap; 0 for the real, trusted certificate.
CERTBOT_STAGING=0
