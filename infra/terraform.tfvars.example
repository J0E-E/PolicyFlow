# Copy this file to terraform.tfvars and fill in real values.
# Real *.tfvars files are git-ignored; this .example template is committed.

# REQUIRED. CIDR allowed to reach SSH (port 22). There is no default, on purpose.
# Set this to the operator's own public IP as a /32 — never 0.0.0.0/0.
# The value below is a documentation-only placeholder (TEST-NET-3); replace it.
ssh_ingress_cidr = "203.0.113.4/32"

# REQUIRED. HTTPS clone URL of the GitHub repo CodeBuild builds from. No default.
# A private repo also needs a one-time CodeBuild source credential (see README).
source_repository_url = "https://github.com/owner/PolicyFlow.git"

# REQUIRED. FullRepositoryId (owner/repo) the pipeline's Source action watches.
# No default — distinct from source_repository_url (the clone URL above).
github_repository_id = "owner/PolicyFlow"

# Optional — these have sensible defaults; uncomment only to override.
# github_branch    = "main"
# region           = "us-east-1"
# instance_type    = "t3.small"
# project_name     = "policyflow"
# hosted_zone_name = "joeyshub.com"               # the EXISTING Route 53 zone (never created)
# domain_name      = "policyflow.joeyshub.com"    # the FQDN the host serves over HTTPS
