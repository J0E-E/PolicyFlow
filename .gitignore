# Local Claude Code config
.claude/

# Environment — real secrets live in .env (never committed); .env.example is the template
.env

# Python
__pycache__/
*.pyc

# Node
node_modules/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
# Real variable files hold operator-specific values (e.g. SSH CIDR); keep the
# committed *.example template. The .terraform.lock.hcl lock file is committed.
*.tfvars
!*.tfvars.example
