{
  "mcpServers": {
    "code-review-graph": {
      "type": "http",
      "url": "http://127.0.0.1:5555/mcp"
    },
    "memory-vault": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "memory-vault-app-1",
        "python",
        "-m",
        "src.mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless",
        "--ignore-https-errors"
      ]
    }
  }
}
