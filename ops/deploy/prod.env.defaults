# Non-secret production defaults, committed and safe to read in the open.
#
# ops/deploy/after_install.sh copies this file to /opt/policyflow/.env on every
# deploy, then appends the two secret passwords (fetched from SSM) and the two
# image refs (CORE_IMAGE / FRONTEND_IMAGE). Secrets and image refs NEVER appear
# here. The full set of vars matches what docker-compose.yml + the prod overlay
# read at boot.

# PostgreSQL — database name + user the core service connects to. The matching
# POSTGRES_PASSWORD is appended at deploy time from SSM.
POSTGRES_USER=policyflow
POSTGRES_DB=policyflow

# RabbitMQ — broker login. The matching RABBITMQ_DEFAULT_PASS is appended at
# deploy time from SSM.
RABBITMQ_DEFAULT_USER=policyflow

# Let's Encrypt / certbot — the prod TLS overlay and the one-time issuance
# bootstrap read these. CERTBOT_EMAIL is a domain alias, not a personal address.
CERTBOT_EMAIL=admin@joeyshub.com
CERTBOT_DOMAIN=policyflow.joeyshub.com
# 0 for the real, trusted certificate; 1 for the staging environment.
CERTBOT_STAGING=0

# Demo/session lifecycle (Epic 13). These reach the core container via the
# explicit core.environment entries in docker-compose.yml (VAR: ${VAR:-default}),
# so the values set here actually override the code defaults in the demo env.
# Auth session widened to 24h so no surprise re-login lands inside the demo
# window; the realistic 8h (28800) stays the non-demo code default.
SESSION_LIFETIME_SECONDS=86400
# Demo visit-session window the masthead counts down (24h); set explicitly for
# out-of-the-box clarity even though it matches the code default.
DEMO_SESSION_LIFETIME_SECONDS=86400
# How often the in-process scheduler runs the expiry purge, in seconds (5 min).
DEMO_PURGE_INTERVAL_SECONDS=300
# UTC hour for the once-a-night canonical wipe back to seed state (quiet hour).
DEMO_NIGHTLY_RESET_HOUR_UTC=4
# The demo runs behind TLS, so the session cookie carries the Secure flag.
SESSION_COOKIE_SECURE=true
